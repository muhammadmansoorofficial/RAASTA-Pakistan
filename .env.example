# APP_URL: The URL where this application is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Required for Neon PostgreSQL persistence in production and Vercel.
# Copy the pooled or direct PostgreSQL connection string from your Neon dashboard.
DATABASE_URL=

# ADMIN_PASSCODE: Optional passcode for the RAASTA Pakistan Admin Dashboard.
# If unset, an inline first-run admin password setup form appears on the Admin page.
ADMIN_PASSCODE=

# SESSION_SECRET: Recommended random secret (32+ chars) for signing Admin Bearer tokens.
# If unset with Neon PostgreSQL, a persistent random secret is stored in raasta_settings.
SESSION_SECRET=

# CRON_SECRET: Optional secret for securing Vercel Cron calls to /api/cron/sync.
CRON_SECRET=
